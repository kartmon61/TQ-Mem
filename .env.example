# Copy to .env (never commit it). tqmem loads it at import time; variables already in the environment win.

# Amazon Bedrock (bedrock: specs in configs/common.yaml) -- standard boto3 credential chain
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BEARER_TOKEN_BEDROCK=        # optional: long-term Bedrock API key for the OpenAI-compatible path (mem0)

# OpenAI API (openai: specs)
# OPENAI_API_KEY=

# Any OpenAI-compatible gateway (gateway: specs)
# LLM_GATEWAY_URL=https://your-gateway.example
# LLM_GATEWAY_KEY=
# LLM_GATEWAY_HEADERS={}           # optional extra headers for mem0's client, as JSON
